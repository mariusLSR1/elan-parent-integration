  },
  "homepage": "https://github.com/mariusLSR1/elan-parent-integration#readme",
  "files": [
    "*.ts",
    "*.tsx",
    "index.html",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "exports": {
    ".": "./index.ts",
    "./rewrites": "./rewrites.ts",
    "./ElanIframe": "./ElanIframe.tsx",
    "./ElanEspaceShell": "./ElanEspaceShell.tsx",
    "./ElanCookieConsent": "./ElanCookieConsent.tsx",
