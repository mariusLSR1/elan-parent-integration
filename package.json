{
  "name": "@mariuslsr1/elan-parent-integration",
  "version": "1.2.3",
  "description": "Next.js parent-site module: reverse-proxy /elan, iframe shell, cookie consent, embed state",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariusLSR1/elan-parent-integration.git"
  },
  "bugs": {
